rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PARTNERS DATABASE (tsytaxi-7e9b0)
    // Handles: partners, partnerRequests
    // ============================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidPartner() {
      let data = request.resource.data;
      return data.keys().hasAll(['partnerId', 'active'])
        && data.partnerId is string
        && data.active is bool
        && data.partnerId.size() > 0;
    }

    function isValidPartnerUpdate() {
      let data = request.resource.data;
      // Ensure critical fields are not changed maliciously
      return data.partnerId == resource.data.partnerId
        && (!data.keys().hasAny(['password']) || data.password.size() >= 6);
    }

    function isOnlineStatusUpdate() {
      // Allow updates to online status fields
      let allowedFields = ['isOnline', 'onlineAt', 'onlineStartTime', 'offlineAt', 'currentLocation'];
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(allowedFields);
    }

    function isValidRequest() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'phone', 'vehicleNumber', 'status'])
        && data.name is string && data.name.size() > 0
        && data.phone is string && data.phone.size() >= 10
        && data.vehicleNumber is string && data.vehicleNumber.size() > 0
        && data.status == 'PENDING';
    }

    // Partners collection
    match /partners/{partnerId} {
      // Read: Allow public read for login verification
      // In production, implement custom authentication and restrict this
      allow read: if true;

      // Create: Allow partner creation (for admin creating accounts)
      // In production, add admin role check
      allow create: if request.resource.data.partnerId == partnerId
        && request.resource.data.partnerId is string
        && request.resource.data.partnerId.size() > 0
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 6;

      // Update: Partners can update their own profile
      // In production, add partner authentication check
      allow update: if isValidPartnerUpdate()
        && (
          // Allow online/offline status updates (isOnline, location, timestamps)
          isOnlineStatusUpdate()
          // Allow profile updates (name, phone, vehicle, email, etc.)
          || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerId', 'createdAt', 'password']))
          // Or password update with proper validation
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'profileUpdatedAt'])
            && request.resource.data.password.size() >= 6)
          // Or allow any authenticated update (for admin operations)
          || isAuthenticated()
        );

      // Delete: Only allow with authentication (admin only in production)
      allow delete: if isAuthenticated();
    }

    // Partner Requests collection
    match /partnerRequests/{requestId} {
      // Create: Anyone can submit a partner application
      allow create: if isValidRequest()
        && request.resource.data.status == 'PENDING';

      // Read: Public read for admin to view requests
      // In production, restrict to admin only
      allow read: if true;

      // Update: Status updates and approval fields (for admin approval/rejection)
      // In production, add admin role check
      allow update: if request.resource.data.status in ['APPROVED', 'REJECTED', 'PENDING'];

      // Delete: Allow deletion (for admin cleanup)
      // In production, add admin role check
      allow delete: if true;
    }
  }
}
