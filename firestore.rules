rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // BOOKINGS DATABASE (tsytaxi-fcbd3)
    // Handles: bookings, trips, users, reviews, coupons
    // ============================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidBooking() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'pickup', 'destination', 'fare', 'status'])
        && data.fare is number && data.fare >= 0
        && data.distanceKm is number && data.distanceKm >= 0
        && data.status in ['PENDING', 'ASSIGNED', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED', 'REJECTED'];
    }

    function isValidStatusUpdate(newStatus) {
      let currentStatus = resource.data.status;
      let validTransitions = {
        'PENDING': ['ASSIGNED', 'CANCELLED'],
        'ASSIGNED': ['ACCEPTED', 'REJECTED', 'CANCELLED'],
        'ACCEPTED': ['IN_PROGRESS', 'CANCELLED'],
        'IN_PROGRESS': ['COMPLETED', 'CANCELLED'],
        'COMPLETED': [],
        'CANCELLED': [],
        'REJECTED': []
      };
      return newStatus in validTransitions[currentStatus];
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update: if request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow delete: if true;
    }

    // Bookings collection - active bookings
    match /bookings/{bookingId} {
      allow create: if isValidBooking()
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.status == 'PENDING';

      allow read: if true;

      allow update: if request.resource.data.keys().hasAll(resource.data.keys())
        && (request.resource.data.status == resource.data.status
          || isValidStatusUpdate(request.resource.data.status));

      allow delete: if resource.data.status in ['CANCELLED', 'REJECTED', 'COMPLETED'];
    }

    // Trips collection - completed trip history
    match /trips/{tripId} {
      allow create: if request.resource.data.status == 'COMPLETED'
        && request.resource.data.keys().hasAll(['partnerId', 'userId', 'fare', 'distanceKm', 'completedAt'])
        && request.resource.data.fare is number
        && request.resource.data.distanceKm is number;

      allow read: if true;

      allow update: if resource.data.status == 'COMPLETED'
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.fare == resource.data.fare
        && request.resource.data.partnerId == resource.data.partnerId;

      allow delete: if false;
    }

    // Reviews collection - trip ratings and feedback
    match /reviews/{reviewId} {
      allow create: if request.resource.data.userId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookingId is string;

      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Coupons collection - discount coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;  // Admin only (restrict in production)
    }

    // Coupon Usage collection - tracking coupon usage
    match /couponUsage/{usageId} {
      allow create: if request.resource.data.userId is string
        && request.resource.data.couponId is string
        && request.resource.data.bookingId is string;

      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
